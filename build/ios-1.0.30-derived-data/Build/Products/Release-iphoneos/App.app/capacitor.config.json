{
	"appId": "top.babylink.app",
	"appName": "BabyLink",
	"webDir": "dist",
	"android": {
		"allowMixedContent": false
	},
	"plugins": {
		"Keyboard": {
			"resize": "native",
			"resizeOnFullScreen": true
		},
		"LocalNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"banner",
				"list"
			]
		}
	},
	"packageClassList": [
		"ContactsPlugin",
		"AppPlugin",
		"AppLauncherPlugin",
		"ClipboardPlugin",
		"DevicePlugin",
		"FilesystemPlugin",
		"GeolocationPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"LocalNotificationsPlugin",
		"SharePlugin",
		"FilePickerPlugin",
		"CapacitorCalendarPlugin"
	]
}
